<?xml version="1.0" encoding="utf-8"?>
<!-- 정차 중에만 보이는 메뉴: 데모 시나리오, 시간대. 재생 전 화면과 재생 화면에 같은 모양으로 들어간다 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Drivescape.SectionTitle"
        android:layout_marginStart="6dp"
        android:text="@string/parked_only" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/scenario"
            style="@style/Drivescape.Button"
            android:layout_width="0dp"
            android:layout_margin="6dp"
            android:layout_weight="1.7"
            android:text="@string/scenario_play" />

        <TextView
            android:id="@+id/tod_auto"
            style="@style/Drivescape.Button"
            android:layout_width="0dp"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:text="자동" />

        <TextView
            android:id="@+id/tod_day"
            style="@style/Drivescape.Button"
            android:layout_width="0dp"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:text="낮" />

        <TextView
            android:id="@+id/tod_night"
            style="@style/Drivescape.Button"
            android:layout_width="0dp"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:text="밤" />
    </LinearLayout>
</LinearLayout>
