<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#22000000">
    <item>
        <selector>
            <!-- 선택된 상태 (시간대 토글 등) -->
            <item android:state_selected="true">
                <shape>
                    <solid android:color="@color/ink" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/panel" />
                    <stroke android:width="1.5dp" android:color="@color/line" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
